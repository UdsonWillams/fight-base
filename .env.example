# FightBase - Environment Configuration Template
# Copy this file to .env and adjust values as needed

# Application
APP_ENVIRONMENT=local
PORT=8080
APP_CORS="*"

# Database (PostgreSQL)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=fight_base
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=dev-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Default Account
ADMIN_DEFAULT_EMAIL=admin@mail.com
ADMIN_DEFAULT_PASSWORD=pass@word

# Machine Learning & GCP (Optional for Local Mode)
GCP_CREDENTIALS_PATH=service_account.json
# LOCAL_MODEL_PATH=models/mma_model.joblib
