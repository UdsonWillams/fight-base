# FightBase - Environment Configuration Template
# Copy this file to .env and adjust values as needed

# Application
APP_ENVIRONMENT=local
PORT=8080
APP_CORS="*"
LOG_ENVIROMENT=INFO
HOST=localhost
WORKERS=3

# Database (PostgreSQL)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=fight_base
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=dev-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Default Account
ADMIN_DEFAULT_EMAIL=admin@mail.com
ADMIN_DEFAULT_PASSWORD=pass@word

# Machine Learning
# Para usar modelo local (recomendado): python scripts/train_model_local.py
LOCAL_MODEL_PATH=models/mma_model_v1.joblib
# Para usar GCS (opcional):
# GCP_CREDENTIALS_PATH=service_account.json
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (Opcional/Futuro)
MONGO_USER=root
MONGO_PASSWORD=pass
MONGO_PORT=27017
